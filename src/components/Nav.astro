---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/about-the-role", label: "The Role" },
  { href: "/contact", label: "Get Involved" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-navy border-b-[3px] border-red">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-3" id="nav-home">
        <div class="font-display text-white text-2xl md:text-3xl tracking-wider leading-none">
          ZACHARY CARTER
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-0" id="desktop-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-2 text-white/80 hover:text-white font-display text-lg tracking-wider uppercase transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
        <a
          href="https://www.facebook.com/ElectZacharyCarter"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-3 px-5 py-2 bg-red hover:bg-red-dark text-white font-display text-lg tracking-wider uppercase transition-colors duration-200 flex items-center gap-2"
          id="nav-facebook"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-10 h-10 text-white"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-open-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-navy border-t border-white/10">
    <div class="px-4 py-4 space-y-0">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block px-4 py-3 text-white/80 hover:text-white font-display text-xl tracking-wider uppercase border-b border-white/5"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://www.facebook.com/ElectZacharyCarter"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-3 mt-2 bg-red text-white font-display text-xl tracking-wider uppercase"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Follow on Facebook
      </a>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-16 md:h-20"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
