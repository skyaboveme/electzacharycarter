---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-white" id="site-footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Brand -->
      <div>
        <div class="font-display text-4xl tracking-wider mb-4">ZACHARY CARTER</div>
        <div class="font-display text-red text-lg tracking-widest mb-6">JUSTICE OF THE PEACE · PCT. 2</div>
        <p class="text-white/60 text-sm font-body leading-relaxed">
          Bastrop County has been my home since I was a child and now I'm raising my family in the community that I have proudly served for the last 19 years.
        </p>
      </div>

      <!-- Links -->
      <div>
        <div class="font-display text-xl tracking-widest mb-4 text-red">NAVIGATE</div>
        <div class="space-y-2">
          <a href="/" class="block text-white/60 hover:text-white text-sm font-body transition-colors">Home</a>
          <a href="/about" class="block text-white/60 hover:text-white text-sm font-body transition-colors">About Zachary</a>
          <a href="/about-the-role" class="block text-white/60 hover:text-white text-sm font-body transition-colors">What Does a JP Do?</a>
          <a href="/contact" class="block text-white/60 hover:text-white text-sm font-body transition-colors">Get Involved</a>
        </div>
      </div>

      <!-- Connect -->
      <div>
        <div class="font-display text-xl tracking-widest mb-4 text-red">CONNECT</div>
        <a
          href="https://www.facebook.com/ElectZacharyCarter"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 text-white/60 hover:text-white transition-colors text-sm font-body group"
          id="footer-facebook"
        >
          <div class="w-10 h-10 border-2 border-white/20 group-hover:border-red group-hover:bg-red flex items-center justify-center transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          Follow on Facebook
        </a>
        <p class="text-white/30 text-sm mt-6 font-body">
          Bastrop County, Texas
        </p>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t-[3px] border-red">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
      <div class="flex flex-col md:flex-row items-center justify-between gap-3">
        <p class="text-white/40 text-xs font-body text-center md:text-left">
          Paid for by the Zachary Carter Campaign. Campaign Treasurer: Annette Murley.
        </p>
        <p class="text-white/30 text-xs font-body">
          &copy; {currentYear} ElectZacharyCarter.com
        </p>
      </div>
    </div>
  </div>
</footer>
