---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thank You | Elect Zachary Carter"
  description="Thank you for supporting Zachary Carter's campaign for Justice of the Peace, Precinct 2, Bastrop County."
>
  <section class="block-bone min-h-[70vh] flex items-center section-pad">
    <div class="max-w-lg mx-auto text-center">
      <div class="border-[3px] border-navy bg-white p-10 md:p-14">
        <div class="font-display text-red text-6xl mb-6">✓</div>
        <h1 class="font-display text-5xl text-ink mb-4">Thank You</h1>
        <div class="editorial-rule mx-auto mb-6"></div>
        <p class="text-editorial text-ink-light mb-10">
          Your message has been received. We appreciate your support for Zachary Carter's campaign for Justice of the Peace.
        </p>

        <div class="flex flex-col gap-3">
          <a href="/" class="btn btn-navy w-full" id="ty-home">
            ← Back to Home
          </a>
          <a
            href="https://www.facebook.com/ElectZacharyCarter"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-red w-full"
            id="ty-facebook"
          >
            Follow on Facebook
          </a>
        </div>

        <div class="mt-8 font-display text-red text-xl tracking-[0.3em]">★ ★ ★</div>
      </div>
    </div>
  </section>

</Layout>
