---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- ============================================ -->
  <!-- HERO. Full navy block, massive typography -->
  <!-- ============================================ -->
  <section class="block-navy relative overflow-hidden" id="hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-24 md:py-36 lg:py-44">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Main headline. takes 7 columns -->
        <div class="lg:col-span-7">
          <div class="reveal">
            <div class="editorial-rule-white mb-8"></div>
          </div>
          <h1 class="text-hero text-white reveal reveal-d1">
            Elect<br/>
            <span class="text-red">Zachary</span><br/>
            Carter
          </h1>
          <div class="mt-8 reveal reveal-d2">
            <div class="font-display text-2xl md:text-3xl text-white/80 tracking-widest mb-2">
              Justice of the Peace
            </div>
            <div class="font-display text-xl text-red tracking-[0.2em] mb-8">
              Precinct 2 · Bastrop County
            </div>
            <p class="text-white/60 font-body text-base leading-relaxed mb-8">
              Experience. Integrity. Justice.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 reveal reveal-d3">
              <a href="/about/" class="btn btn-red" id="hero-learn-more">
                Meet Zachary →
              </a>
              <a href="https://www.facebook.com/profile.php?id=61593585525908" target="_blank" rel="noopener noreferrer" class="btn btn-outline-white" id="hero-facebook">
                Facebook
              </a>
            </div>
          </div>
        </div>

        <!-- Headshot column -->
        <div class="lg:col-span-5 reveal reveal-d2">
          <div class="border-[3px] border-white/20 overflow-hidden">
            <img src="/assets/Headshot.jpg" alt="Zachary Carter, candidate for Justice of the Peace, Precinct 2, Bastrop County" class="w-full h-auto block" loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- RED BAR. Hard statistics strip -->
  <!-- ============================================ -->
  <section class="block-red" id="stats-bar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 border-l border-white/20">
        <div class="border-r border-white/20 px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">19+</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Years of Service</div>
        </div>
        <div class="border-r border-white/20 px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">LAW</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Enforcement</div>
        </div>
        <div class="border-r border-white/20 px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">COURT</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Justice & Municipal</div>
        </div>
        <div class="px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">LOCAL</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Bastrop County Roots</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PERSONAL STATEMENT. Editorial quote block -->
  <!-- ============================================ -->
  <section class="block-white section-pad" id="statement">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Photo column -->
        <div class="lg:col-span-5">
          <div class="border-[3px] border-navy overflow-hidden">
            <img src="/assets/jZbvNz8cRxODPBULevs6gA.jpg" alt="Zachary Carter in uniform at the Texas State Capitol" class="w-full h-auto block" loading="lazy" />
          </div>
          <div class="font-display text-xs tracking-[0.15em] text-ink-light mt-3">AT THE TEXAS STATE CAPITOL</div>
        </div>
        <!-- Quote column -->
        <div class="lg:col-span-7">
          <div class="red-bar-left">
            <div class="font-display text-sm tracking-[0.2em] text-red mb-6">IN HIS OWN WORDS</div>
            <blockquote class="font-body text-2xl sm:text-3xl md:text-4xl text-ink italic leading-snug mb-8">
              "Bastrop County has been my home since I was a child and now I'm raising my family in the community that I have proudly served for the last <span class="not-italic font-bold text-red">19 years</span>."
            </blockquote>
            <p class="text-editorial text-ink-light">
              I bring education and experience from <strong>corrections</strong>, <strong>law enforcement</strong>, <strong>Municipal Court</strong>, and <strong>Justice Court</strong>: the exact combination needed to serve you as your next Justice of the Peace.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- QUALIFICATIONS. Two-column editorial layout -->
  <!-- ============================================ -->
  <section class="block-bone section-pad" id="qualifications">
    <div class="max-w-7xl mx-auto">
      <div class="mb-14">
        <div class="editorial-rule mb-6"></div>
        <h2 class="text-section text-ink">Qualified<br/>to Serve</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 border-3 border-navy">
        <!-- Corrections -->
        <div class="hard-card border-b-[3px] md:border-b-0 md:border-r-[3px] border-navy" id="qual-corrections">
          <div class="font-display text-red text-sm tracking-[0.2em] mb-3">01</div>
          <h3 class="font-display text-3xl text-ink mb-4">Corrections</h3>
          <p class="text-editorial text-ink-light">
            Hands-on experience in the corrections system, understanding rehabilitation, consequences, and the human side of justice from the ground level.
          </p>
        </div>

        <!-- Law Enforcement -->
        <div class="hard-card border-b-[3px] border-navy" id="qual-law-enforcement">
          <div class="font-display text-red text-sm tracking-[0.2em] mb-3">02</div>
          <h3 class="font-display text-3xl text-ink mb-4">Law Enforcement</h3>
          <p class="text-editorial text-ink-light">
            Trained to protect and serve, with deep knowledge of criminal procedure, constitutional rights, and public safety. The foundation of fair justice.
          </p>
        </div>

        <!-- Municipal Court -->
        <div class="hard-card md:border-r-[3px] border-navy" id="qual-municipal">
          <div class="font-display text-red text-sm tracking-[0.2em] mb-3">03</div>
          <h3 class="font-display text-3xl text-ink mb-4">Municipal Court</h3>
          <p class="text-editorial text-ink-light">
            Direct courtroom experience in municipal proceedings, understanding civil process, hearings, and serving the public with integrity.
          </p>
        </div>

        <!-- Justice Court -->
        <div class="hard-card" id="qual-justice-court">
          <div class="font-display text-red text-sm tracking-[0.2em] mb-3">04</div>
          <h3 class="font-display text-3xl text-ink mb-4">Justice Court</h3>
          <p class="text-editorial text-ink-light">
            Current experience in the very court system he seeks to lead. Zachary knows exactly what it takes to run a fair and efficient Justice Court.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- WHAT DOES A JP DO. Asymmetric editorial -->
  <!-- ============================================ -->
  <section class="block-white section-pad" id="jp-preview">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

        <!-- Left: Headline + content (7 cols) -->
        <div class="lg:col-span-7">
          <div class="editorial-rule mb-6"></div>
          <div class="font-display text-sm tracking-[0.2em] text-red mb-4">KNOW YOUR COURT</div>
          <h2 class="text-section text-ink mb-8">
            What Does a Justice<br/>of the Peace Do?
          </h2>
          <p class="text-editorial text-ink-light mb-8">
            The Justice of the Peace is the judicial official closest to the people. From presiding over trials and handling evictions to issuing warrants and performing marriages, the JP touches the lives of everyday Texans.
          </p>
          <ul class="star-list text-editorial text-ink mb-10">
            <li>Presides over criminal & civil trials</li>
            <li>Handles small claims and evictions up to $20,000</li>
            <li>Issues search & arrest warrants</li>
            <li>Sets bail and conducts hearings</li>
            <li>Performs marriage ceremonies</li>
            <li>Conducts death inquests as coroner</li>
            <li>Handles truancy and juvenile matters</li>
          </ul>
          <a href="/about-the-role/" class="btn btn-navy" id="jp-learn-more">
            Full Breakdown →
          </a>
        </div>

        <!-- Right: Bold data column (5 cols) -->
        <div class="lg:col-span-5">
          <div class="bg-navy p-8 md:p-10 h-full flex flex-col justify-center">
            <div class="space-y-8">
              <div class="border-b border-white/10 pb-6">
                <div class="font-display text-5xl text-red">Criminal</div>
                <div class="font-body text-white/60 text-sm mt-2">Class C misdemeanor cases: traffic violations, public intoxication, minor offenses punishable by fine</div>
              </div>
              <div class="border-b border-white/10 pb-6">
                <div class="font-display text-5xl text-white">Civil</div>
                <div class="font-body text-white/60 text-sm mt-2">Cases up to $20,000: small claims, debt disputes, landlord/tenant conflicts, evictions</div>
              </div>
              <div class="border-b border-white/10 pb-6">
                <div class="font-display text-5xl text-white">Magistrate</div>
                <div class="font-body text-white/60 text-sm mt-2">Warrants, bail, preliminary hearings, oaths, juvenile warnings</div>
              </div>
              <div>
                <div class="font-display text-5xl text-red">Community</div>
                <div class="font-body text-white/60 text-sm mt-2">Marriage ceremonies, death inquests, truancy hearings, local complaints</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- WHY ZACHARY. Full navy CTA block -->
  <!-- ============================================ -->
  <section class="block-navy section-pad" id="why-zachary">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text -->
        <div class="lg:col-span-7">
          <div class="editorial-rule-white mb-6"></div>
          <h2 class="text-section text-white mb-8">
            Why <span class="text-red">Zachary Carter</span>?
          </h2>
          <p class="text-editorial text-white/70 mb-4">
            With nearly two decades of hands-on experience across <strong class="text-white">corrections</strong>, <strong class="text-white">law enforcement</strong>, <strong class="text-white">municipal court</strong>, and <strong class="text-white">justice court</strong>, Zachary Carter doesn't just understand the justice system. He's lived it.
          </p>
          <p class="text-editorial text-white/60 mb-12">
            He's raising his family right here in Bastrop County because he believes in this community. Now he's ready to serve it from the bench.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact/" class="btn btn-red" id="cta-get-involved">
              Get Involved →
            </a>
            <a href="https://www.facebook.com/profile.php?id=61593585525908" target="_blank" rel="noopener noreferrer" class="btn btn-outline-white" id="cta-facebook">
              Join on Facebook
            </a>
          </div>
        </div>
        <!-- Community photo -->
        <div class="lg:col-span-5">
          <div class="border-[3px] border-white/20 overflow-hidden">
            <img src="/assets/IMG_2586.jpg" alt="Zachary Carter and campaign team volunteering at a Bastrop County community event" class="w-full h-auto block" loading="lazy" />
          </div>
          <div class="font-display text-xs tracking-[0.15em] text-white/40 mt-3">SERVING THE COMMUNITY</div>
        </div>
      </div>
    </div>
  </section>

</Layout>
