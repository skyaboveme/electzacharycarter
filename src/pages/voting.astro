---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Voting Locations & Times | Elect Zachary Carter | Bastrop County, TX"
  description="Find your early voting and Election Day polling locations, dates, and times for the 2026 General Election in Bastrop County, Texas."
  keywords="Bastrop County voting locations, early voting, Election Day, polling places, 2026 General Election, Bastrop County TX, Zachary Carter"
>

  <!-- ============================================ -->
  <!-- HERO. Page header block -->
  <!-- ============================================ -->
  <section class="block-navy relative overflow-hidden" id="voting-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-20 md:py-28 lg:py-36">
      <div class="reveal">
        <div class="editorial-rule-white mb-8"></div>
      </div>
      <h1 class="text-hero text-white reveal reveal-d1">
        Voting<br/>
        <span class="text-red">Locations</span><br/>
        & Times
      </h1>
      <div class="mt-8 reveal reveal-d2">
        <div class="font-display text-2xl md:text-3xl text-white/80 tracking-widest mb-2">
          2026 General & Special Elections
        </div>
        <div class="font-display text-xl text-red tracking-[0.2em]">
          Bastrop County, Texas
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- RED BAR. Key dates strip -->
  <!-- ============================================ -->
  <section class="block-red" id="key-dates-bar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 border-l border-white/20">
        <div class="border-r border-white/20 px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">OCT 5</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Last Day to Register</div>
        </div>
        <div class="border-r border-white/20 px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">OCT 19–30</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Early Voting Period</div>
        </div>
        <div class="px-6 py-6 md:py-8">
          <div class="font-display text-4xl md:text-5xl text-white">NOV 3</div>
          <div class="font-display text-sm tracking-[0.15em] text-white/70 mt-1">Election Day</div>
        </div>
      </div>
    </div>
  </section>

