---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title = "Elect Zachary Carter | Justice of the Peace, Precinct 2 | Bastrop County, TX",
  description = "Elect Zachary Carter for Justice of the Peace, Precinct 2 in Bastrop County, Texas. 19 years of experience in corrections, law enforcement, Municipal and Justice Court. Experience. Integrity. Justice.",
  keywords = "Zachary Carter, Justice of the Peace, Bastrop County, Precinct 2, Texas, elect, JP, law enforcement, corrections, justice court, municipal court, Smithville",
  ogImage = "/images/og-default.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(ogImage, Astro.site);

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZP6STFK27E"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-ZP6STFK27E');
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- AI Discovery -->
  <link rel="alternate" type="text/plain" href="/llm.txt" title="LLM Content" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Site Index" />

  <!-- Geo / Local SEO -->
  <meta name="geo.region" content="US-TX" />
  <meta name="geo.placename" content="Bastrop County, Texas" />
  <meta name="geo.position" content="30.1105;-97.3153" />
  <meta name="ICBM" content="30.1105, -97.3153" />

  <!-- JSON-LD: Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Zachary Carter",
    "jobTitle": "Candidate for Justice of the Peace, Precinct 2",
    "url": "https://electzacharycarter.com",
    "sameAs": [
      "https://www.facebook.com/ElectZacharyCarter"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bastrop County",
      "addressRegion": "TX",
      "addressCountry": "US"
    },
    "description": "Candidate for Justice of the Peace, Precinct 2, Bastrop County, Texas. 19 years of experience in corrections, law enforcement, Municipal and Justice Court.",
    "knowsAbout": [
      "Criminal Justice",
      "Law Enforcement",
      "Corrections",
      "Municipal Court Administration",
      "Justice Court Operations",
      "Texas Judicial System"
    ]
  })} />

  <!-- JSON-LD: WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Elect Zachary Carter",
    "url": "https://electzacharycarter.com",
    "description": "Official campaign website for Zachary Carter, candidate for Justice of the Peace, Precinct 2, Bastrop County, Texas.",
    "publisher": {
      "@type": "Person",
      "name": "Zachary Carter"
    }
  })} />

  <!-- JSON-LD: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://electzacharycarter.com/" },
      { "@type": "ListItem", "position": 2, "name": "About Zachary", "item": "https://electzacharycarter.com/about/" },
      { "@type": "ListItem", "position": 3, "name": "The Role", "item": "https://electzacharycarter.com/about-the-role/" },
      { "@type": "ListItem", "position": 4, "name": "Get Involved", "item": "https://electzacharycarter.com/contact/" }
    ]
  })} />
</head>
<body class="min-h-screen flex flex-col bg-white">
  <Nav />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
